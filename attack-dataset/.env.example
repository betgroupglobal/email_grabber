# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-opus-4-5

# ── Knowledge Engine ──────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://opsec:opsec@localhost:5432/attack_db
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=attacks
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATASET_PATH=/Users/adminuser/attack-dataset/Attack_Dataset.csv
API_HOST=0.0.0.0
API_PORT=8000
INTEGRATION_HUB_URL=http://localhost:8500
SERVICE_API_KEY_INTEGRATION_HUB=your-integration-hub-api-key

# ── Real-time Analyzer ────────────────────────────────────────────────────────
ANALYZER_ADDR=:8001
KNOWLEDGE_ENGINE_URL=http://localhost:8000
ORCHESTRATOR_URL=http://localhost:3001
NMAP_BIN=nmap

# ── OpSec Monitor ─────────────────────────────────────────────────────────────
# (runs on port 8002 by default)

# ── Orchestrator ──────────────────────────────────────────────────────────────
PORT=3001
OPSEC_URL=http://localhost:8002
# Optional: OpenRouter powers orchestrator AI summaries and MITRE mapping (first choice)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional client auth (unset in local dev; set in production)
ORCHESTRATOR_API_KEY=
SERVICE_API_KEY_ORCHESTRATOR=your-orchestrator-service-key
# Live Attack Council — replan chains on step failure using KE dataset + ML
LIVE_COUNCIL_DEFAULT=false
LIVE_MAX_REPLANS=5
LIVE_REPLAN_TOP_CHAINS=3
# Risk guardrails removed by design for authorized red-team / lab use.
ALLOW_HIGH_RISK=true
LIVE_REQUIRE_APPROVAL=false
LIVE_COUNCIL_DEBOUNCE_MS=2000
LIVE_COUNCIL_RATE_LIMIT=12
# Informational only — does not pause execution when set high (999 disables veto scoring gate).
LIVE_OPSEC_VETO_THRESHOLD=999

# ── Dashboard (Next.js — use NEXT_PUBLIC_* for browser API calls) ─────────────
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:3001
NEXT_PUBLIC_ANALYZER_URL=http://localhost:8001
NEXT_PUBLIC_KNOWLEDGE_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_OPSEC_URL=http://localhost:8002
NEXT_PUBLIC_ORCHESTRATOR_API_KEY=
# Legacy CRA names (optional)
REACT_APP_ORCHESTRATOR_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001
REACT_APP_INTEGRATION_HUB_URL=http://localhost:8500

# ── Integration Hub ─────────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8500
ENVIRONMENT=development
LOG_LEVEL=INFO
INTEGRATION_CONFIG_DIR=integrations
INTEGRATION_PLUGIN_DIR=integrations
REDIS_URL=redis://localhost:6379
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your-vault-token
DOCKER_HOST=unix:///var/run/docker.sock
OPSEC_MONITOR_URL=http://localhost:8002
# OpSec assessments run for telemetry only — never block plugin execution.
OPSEC_ASSESSMENT_ENABLED=true
SERVICE_API_KEY_INTEGRATION_HUB=your-integration-hub-api-key

# ── MCP / Burp Suite (Orchestrator — PortSwigger MCP Server) ─────────────────
# Install Burp MCP extension: https://github.com/PortSwigger/mcp-server
# Enable MCP tab in Burp → server at http://127.0.0.1:9876 (SSE) or use stdio proxy:
#   java -jar mcp-proxy-all.jar --sse-url http://127.0.0.1:9876
MCP_BURP_ENABLED=0
MCP_MOCK=0
# MCP_BURP_URL=http://127.0.0.1:9876
# MCP_BURP_COMMAND=/path/to/java -jar /path/to/mcp-proxy-all.jar --sse-url http://127.0.0.1:9876
# MCP_BURP_ARGS=
# MCP_BURP_TOKEN=
# Extra MCP servers (community Burp AI Agent, etc.):
# MCP_SERVERS_JSON=[{"id":"burp_ai","name":"Burp AI Agent","url":"http://127.0.0.1:9877"}]

# ── Metasploit (Integration Hub plugin) ─────────────────────────────────────
# Optional: install metasploit-framework on the integration-hub host or mount into container
MSF_PATH=msfconsole
MSFVENOM_PATH=msfvenom
# MSF_MOCK=1  # unit tests / CI without local Metasploit install
# MSF_RPC_HOST=127.0.0.1
# MSF_RPC_PORT=55553
# MSF_RPC_TOKEN=

# ── Web scanner plugins (Integration Hub) ─────────────────────────────────────
NUCLEI_PATH=nuclei
NUCLEI_MOCK=0
FFUF_PATH=ffuf
FFUF_WORDLIST_PATH=/usr/share/wordlists/dirb/common.txt
FFUF_MOCK=0
SQLMAP_PATH=sqlmap
SQLMAP_MOCK=0

# ── Jailbreak AI ───────────────────────────────────────────────────────────────
# Primary AI for chat, attack-step guidance, and MITRE mapping when OPENROUTER_API_KEY is unset.
# Set on integration-hub (docker-compose passes this through). MITRE /ai/chat use hub → jailbreak_ai.
JAILBREAK_API_KEY=your-jailbreak-api-key
# Route orchestrator step guidance and MITRE LLM calls through Integration Hub (default true)
JAILBREAK_VIA_HUB=true

